{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "sltk/my-trophies",
    "title": "My Trophies",
    "category": "sltk",
    "icon": "awards",
    "description": "Shows the current logged-in user's trophies.",
    "textdomain": "sim-league-toolkit",
    "attributes": {
        "limit": {
            "type": "number",
            "default": 0
        }
    },
    "supports": {
        "html": false,
        "color": {
            "background": true,
            "text": true,
            "link": false
        },
        "spacing": {
            "padding": true,
            "margin": true
        },
        "border": {
            "color": true,
            "radius": true,
            "width": true
        }
    },
    "editorScript": "file:./index.js",
    "style": "file:./style-index.css"
}
